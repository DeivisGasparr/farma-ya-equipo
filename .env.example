# ============================================
# FarmaYa environment variables (example only)
# Copy this file to .env and replace placeholders.
# ============================================

# Required secrets (set strong unique values)
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_PASSWORD=change_this_app_password

# Database configuration
MYSQL_DATABASE=farmaya
MYSQL_USER=farmaya_app
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Spring Boot datasource (optional override)
SPRING_DATASOURCE_URL=jdbc:mysql://farmaya-db:3306/farmaya?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=farmaya_app
SPRING_DATASOURCE_PASSWORD=change_this_app_password

# SQL init behavior
# Development with Docker Compose: always
# Production: never
SPRING_SQL_INIT_MODE=always
